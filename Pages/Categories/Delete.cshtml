@page "{id:int}"
@model BlogApp.Pages.Categories.DeleteModel

@{
    ViewData["Title"] = "Delete Category";
}

<h2>Delete Category</h2>

@if (Model.Category != null)
{
    <div class="card mt-3">
        <div class="card-body">
            <h4 class="card-title">@Model.Category.Name</h4>
            <p class="text-muted mb-2">Posts in this category: @Model.Category.Posts.Count</p>
        </div>
    </div>

    <form method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.Category.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="/Categories/Index" class="btn btn-secondary">Back to List</a>
    </form>
}

