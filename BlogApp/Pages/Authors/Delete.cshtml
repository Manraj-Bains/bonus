@page "{id:int}"
@model BlogApp.Pages.Authors.DeleteModel

@{
    ViewData["Title"] = "Delete Author";
}

<h2>Delete Author</h2>

@if (Model.Author != null)
{
    <div class="card mt-3">
        <div class="card-body">
            <h4 class="card-title">@Model.Author.Name</h4>
            <p class="text-muted mb-2">Posts by this author: @Model.Author.Posts.Count</p>
        </div>
    </div>

    <form method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.Author.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="/Authors/Index" class="btn btn-secondary">Back to List</a>
    </form>
}

