@page "{id:int}"
@model BlogApp.Pages.Authors.DetailsModel

@{
    ViewData["Title"] = "Author Details";
}

<h2>Author Details</h2>

@if (Model.Author != null)
{
    <div class="card mt-3">
        <div class="card-body">
            <h4 class="card-title">@Model.Author.Name</h4>
            <p class="text-muted mb-2">Posts: @Model.Author.Posts.Count</p>

            @if (Model.Author.Posts.Count > 0)
            {
                <h5 class="mt-3">Posts by this author</h5>
                <ul>
                    @foreach (var post in Model.Author.Posts.OrderByDescending(p => p.Id))
                    {
                        <li>
                            <a asp-page="/Posts/Details" asp-route-id="@post.Id">@post.Title</a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="mt-3">
        <a class="btn btn-warning btn-sm" asp-page="/Authors/Edit" asp-route-id="@Model.Author.Id">Edit</a>
        <a class="btn btn-danger btn-sm" asp-page="/Authors/Delete" asp-route-id="@Model.Author.Id">Delete</a>
        <a class="btn btn-secondary btn-sm" asp-page="/Authors/Index">Back to List</a>
    </div>
}

