@page "{id:int}"
@model BlogApp.Pages.Posts.DetailsModel

@{
    ViewData["Title"] = "Post Details";
}

<div class="row">
    <div class="col-md-8">
        <a asp-page="/Posts/Index" class="btn btn-secondary btn-sm mb-3">Back to List</a>

        @if (Model.Post != null)
        {
            <h2>@Model.Post.Title</h2>
            <p class="text-muted">
                By @Model.Post.Author?.Name in @Model.Post.Category?.Name
            </p>

            <div class="card mt-3">
                <div class="card-body">
                    <p class="mb-0">@Model.Post.Content</p>
                </div>
            </div>

            <div class="mt-3">
                <a class="btn btn-warning btn-sm" asp-page="/Posts/Edit" asp-route-id="@Model.Post.Id">Edit</a>
                <a class="btn btn-danger btn-sm" asp-page="/Posts/Delete" asp-route-id="@Model.Post.Id">Delete</a>
            </div>
        }
    </div>

    <div class="col-md-4">
        <h4 class="mb-3">Related Posts</h4>

        @if (Model.RelatedPosts.Count == 0)
        {
            <p>No related posts.</p>
        }
        else
        {
            <ul class="list-unstyled">
                @foreach (var post in Model.RelatedPosts)
                {
                    <li class="mb-2">
                        <a asp-page="/Posts/Details" asp-route-id="@post.Id">@post.Title</a>
                    </li>
                }
            </ul>
        }
    </div>
</div>

