@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="row">
    <div class="col-md-8">
        <h2 class="mb-3">All Posts</h2>

        @foreach (var post in Model.Posts)
        {
            var excerpt = post.Content.Length > 160
                ? post.Content.Substring(0, 160) + "..."
                : post.Content;

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@post.Title</h5>
                    <p class="text-muted mb-1">
                        By @post.Author?.Name in @post.Category?.Name
                    </p>
                    <p class="card-text">@excerpt</p>
                    <a class="btn btn-primary btn-sm" asp-page="/Posts/Details" asp-route-id="@post.Id">
                        Read more
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <h4 class="mb-3">Categories</h4>

        @foreach (var category in Model.CategoriesWithPosts)
        {
            <h6 class="mt-3">@category.Name</h6>
            <ul class="list-unstyled">
                @foreach (var p in category.Posts.OrderByDescending(x => x.Id))
                {
                    <li class="mb-1">
                        <a asp-page="/Posts/Details" asp-route-id="@p.Id">@p.Title</a>
                    </li>
                }
            </ul>
        }
    </div>
</div>
